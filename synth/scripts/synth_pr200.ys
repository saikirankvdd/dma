# ==============================================================================
# Full ASIC Synthesis Script: PR200 AXI DMA (dma_axi32)
# Target Technology: SkyWater 130nm High-Density Standard Cells (sky130_fd_sc_hd)
# ==============================================================================

# 1. Read RTL files
read_verilog -Idma_axi/src/dma_axi32 dma_axi/src/dma_axi32/dma_axi32_defines.v
read_verilog -Idma_axi/src/dma_axi32 dma_axi/src/dma_axi32/dma_axi32.v
